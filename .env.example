# Copy to .env and fill in. Never commit .env.
REGION_PROFILE=regions/samosir.json

# LLM port: openai_compatible | anthropic | none  (none = rules only)
# Default: small open model on our GPU server via Ollama's OpenAI-compatible API.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://theubuntu:11434/v1
LLM_MODEL=
LLM_API_KEY=

# SMS gateway: twilio | android | simulator
SMS_GATEWAY=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
ANDROID_GATEWAY_URL=
ANDROID_GATEWAY_USER=
ANDROID_GATEWAY_PASSWORD=
