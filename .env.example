# Copy to .env and fill in. Never commit .env.
REGION_PROFILE=regions/samosir.json
HOST=127.0.0.1
PORT=8000
SIMULATOR=1                 # 1 = enable the demo SMS simulator endpoints
DATA_ORIGIN=synthetic       # label for listings created from SMS

# LLM port: simulated | openai_compatible | anthropic | none
#   simulated: outputs written in advance for the example messages (hackathon demo, no model runs)
LLM_PROVIDER=simulated
LLM_SIMULATED_PATH=         # default: models/simulated/<region id>.json
LLM_BASE_URL=               # e.g. http://<server>:11434/v1 for Ollama
LLM_MODEL=                  # e.g. qwen3:1.7b
LLM_API_KEY=
LLM_USER_SUFFIX=            # e.g. " /no_think" for Qwen3

# SMS gateway: simulator | android
SMS_GATEWAY=simulator
SMS_PUBLIC_NUMBER=          # the gateway phone's number, shown in the traveller app
SMSGATE_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_USER=
SMSGATE_PASSWORD=
SMSGATE_SIGNING_KEY=        # optional: verify webhook signatures
