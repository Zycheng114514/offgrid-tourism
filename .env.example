# Copy to .env and fill in. Never commit .env.
REGION_PROFILE=regions/samosir.json

# LLM (any one; leave all empty to run on rules only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# SMS gateway: twilio | android | simulator
SMS_GATEWAY=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=
ANDROID_GATEWAY_URL=
ANDROID_GATEWAY_USER=
ANDROID_GATEWAY_PASSWORD=
